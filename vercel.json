{
  "version": 2, "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/archive.js": {"includeFiles": "vault/**", "maxDuration": 10}},
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
  ]}]
}

